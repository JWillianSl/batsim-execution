# Batsim Docker environment — parâmetros de simulação/imagem.
# Não contém segredos. É seguro versionar este arquivo.

# Imagem Docker do Batsim
BATSIM_IMAGE=oarteam/batsim
BATSIM_IMAGE_TAG=4.2.0

# Rede (host é exigido para o protocolo REQ-REP entre Batsim e o scheduler)
BATSIM_NETWORK_MODE=host

# Arquivos de entrada (caminhos relativos a ./data)
BATSIM_PLATFORM_FILE=platforms/small_platform.xml
BATSIM_WORKLOAD_FILE=workloads/test_one_computation_job.json

# Saída (caminho relativo a ./data)
BATSIM_OUTPUT_DIR=output

# Scheduler (batsched)
BATSCHED_ALGORITHM=easy_bf
BATSCHED_NUR_KAPACK_REV=774b7f56c3efc93adb73ee82a62faf5dc2fce112
BATSCHED_SRC_REV=17072778995100fc90214ea4910bf5b171adfd0d

# Smoke test (timeout da simulação completa, incluindo o caminho de falha)
SMOKE_TEST_SIMULATION_TIMEOUT_SECONDS=60
